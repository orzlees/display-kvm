      {"id": "windows-amd64", "goos": "windows", "goarch": "amd64", "cgo_enabled": "0", "tags": ["production"], "entry": "sh build/build-windows.sh --target windows-amd64 --version <label> --run-id <gui-id>", "app": "build/out/<gui-id>/displaykvm.exe", "package_entry": "sh packaging/package.sh windows --run-id <package-id> --app build/out/<gui-id>/displaykvm.exe --core-run-id <core-id>", "archive": "zip", "status": "candidate-build-entry", "signing": "unsigned", "limitations": "编译入口与原生无屏测试工作流已提供但未执行；Windows10/11及相应架构WebView2 Runtime为运行前提；运行、登录启动与硬件待验收"},
